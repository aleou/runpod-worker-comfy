# syntax=docker/dockerfile:1
# --------------------------------------------------------
# Cible minimax-h3 : MiniMax H3 (vidéo + audio) + LoRA turbo 8 steps + Veda
# Image autoportée : les 9 modèles sont embarqués, aucun network volume.
# Build : docker buildx bake minimax-h3 --push   (voir MINIMAX_H3.md)
# --------------------------------------------------------
FROM runpod/pytorch:2.8.0-py3.11-cuda12.8.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_PREFER_BINARY=1 \
    PYTHONUNBUFFERED=1 \
    COMFY_POLLING_INTERVAL_MS=250 \
    COMFY_POLLING_MAX_RETRIES=7200 \
    REFRESH_WORKER=false \
    REQUIRE_S3=true \
    TRITON_CACHE_DIR=/tmp/triton

# build-essential + python3.11-dev : Triton compile un petit lanceur C au premier appel
# ffmpeg : mux audio et vidéo
RUN apt-get update && apt-get install -y --no-install-recommends \
      git aria2 ffmpeg libgl1 build-essential python3.11-dev ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# PyTorch cu130 par-dessus le torch 2.8 cu128 de l'image de base.
# torchaudio n'est pas réinstallé : ComfyUI 0.39.2 ne l'importe pas, et la dernière
# roue cu130 (2.11.0) n'est pas construite pour torch 2.14.
ARG TORCH_VERSION=2.14.1
ARG TORCHVISION_VERSION=0.29.1
RUN python3 -m pip install --upgrade pip \
 && python3 -m pip uninstall -y torch torchvision torchaudio \
 && (python3 -m pip freeze | grep -iE '^nvidia-[a-z0-9-]+-cu12' | cut -d= -f1 | xargs -r python3 -m pip uninstall -y) \
 && python3 -m pip install \
      --index-url https://download.pytorch.org/whl/cu130 \
      --extra-index-url https://pypi.org/simple \
      torch==${TORCH_VERSION} torchvision==${TORCHVISION_VERSION} \
 && printf 'torch==%s\ntorchvision==%s\n' "${TORCH_VERSION}" "${TORCHVISION_VERSION}" > /pip-constraints.txt

# Tout pip install ultérieur (build ou debug sur le pod) garde ce torch
ENV PIP_CONSTRAINT=/pip-constraints.txt

RUN git clone --depth 1 --branch v0.39.2 https://github.com/comfyanonymous/ComfyUI /comfyui \
 && python3 -m pip install -r /comfyui/requirements.txt

# Veda 0.3.1 (commit "release: 0.3.1")
ARG VEDA_COMMIT=8d7ac153ac215d636eaf1b5910b0536c3de9e6ed
RUN git clone https://github.com/veda-sparse/Veda-on-ComfyUI /comfyui/custom_nodes/veda-sparse-attention \
 && cd /comfyui/custom_nodes/veda-sparse-attention && git checkout ${VEDA_COMMIT} \
 && python3 -m pip install -r requirements.txt

RUN python3 -m pip install runpod requests boto3 soundfile

# Le build échoue ici si l'environnement est faux (torch rétrogradé en cu12x,
# Triton absent, en-têtes Python ou compilateur C manquants pour Triton).
RUN python3 -c "import sys, sysconfig, os, torch, torchvision, triton; \
assert sys.version_info[:2] == (3, 11), sys.version; \
assert torch.version.cuda.startswith('13'), torch.version.cuda; \
assert os.path.isfile(os.path.join(sysconfig.get_paths()['include'], 'Python.h')), 'Python.h introuvable'; \
print('torch', torch.__version__, 'torchvision', torchvision.__version__, 'triton', triton.__version__)" \
 && gcc --version | head -n 1

# --------------------------------------------------------
# Modèles : un RUN (une couche) par fichier, taille et SHA-256 vérifiés.
# Révisions HF figées par hash de commit. Token HF facultatif (rate-limit),
# passé en secret BuildKit pour ne pas rester dans l'historique de l'image.
# --------------------------------------------------------
COPY scripts/fetch_model.sh /fetch_model.sh
RUN sed -i 's/\r$//' /fetch_model.sh && chmod +x /fetch_model.sh

ARG HF=https://huggingface.co
ARG H3_REPO=Comfy-Org/MiniMax-H3/resolve/e5eb578a89295337b8ff433a035929ce0279e0b6
ARG H3_LORA_REPO=drbaph/MiniMax-H3-Turbo-Lora-ComfyUI/resolve/bb2bc497cbaca89dadd0bcf1856eed4f8275be20
ARG VEDA_T2VA_REPO=Veda-Sparse/Minimax-H3-T2VA-Veda-8NFE-600Step-Preview/resolve/9a1fd3a41b4a754a7886e64e82edbddf599fd1bd
ARG VEDA_R2VA_REPO=Veda-Sparse/Minimax-H3-R2VA-Veda-Preview/resolve/1598b407905b7c0af85aa0c13acdfa6f01ff2982

RUN --mount=type=secret,id=hf_token /fetch_model.sh \
    $HF/$H3_REPO/diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors \
    diffusion_models minimax_h3_fl2va_pruned_int8_convrot.safetensors 20970379616 \
    e889202c41dafb67b10d67b97f0d8541508036a6090af23425a5c2615d03c47a

RUN --mount=type=secret,id=hf_token /fetch_model.sh \
    $HF/$H3_REPO/diffusion_models/minimax_h3_ref2va_pruned_int8_convrot.safetensors \
    diffusion_models minimax_h3_ref2va_pruned_int8_convrot.safetensors 20970379616 \
    9255f52b6677845ad238f20dfaafa94727053694127ab7f255c048f0f9365779

RUN --mount=type=secret,id=hf_token /fetch_model.sh \
    $HF/$H3_REPO/text_encoders/qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors \
    text_encoders qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors 15687142551 \
    35a88d51044231fe332301d7a62aa81e3f2cba62febeb446e2c1e3e0ef76f2c6

RUN --mount=type=secret,id=hf_token /fetch_model.sh \
    $HF/$H3_REPO/vae/minimax_h3_video_vae_int8_convrot.safetensors \
    vae minimax_h3_video_vae_int8_convrot.safetensors 2811065184 \
    52a2c8c73583c86e4f41cdcce3a6ad0ea562987bc0bf3d60a0cef5f5c8e60c0e

RUN --mount=type=secret,id=hf_token /fetch_model.sh \
    $HF/$H3_REPO/vae/minimax_h3_audio_vae_fp32.safetensors \
    vae minimax_h3_audio_vae_fp32.safetensors 605254808 \
    8e505d95dd1561d47abd43d4238fd40d9bb1ae9e147ed0a4cba778d76ae4db48

RUN --mount=type=secret,id=hf_token /fetch_model.sh \
    $HF/$H3_REPO/loras/minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors \
    loras minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors 1956193000 \
    2339acdf19bfe123f46b971ea35d367a84adb85de43627e1eceafa5a5b2b111e

RUN --mount=type=secret,id=hf_token /fetch_model.sh \
    $HF/$H3_LORA_REPO/minimax_h3_ref2v_turbo_8step_v1.0_768p_comfyui_resized_avg_rank_64_bf16.safetensors \
    loras minimax_h3_ref2v_turbo_8step_v1.0_768p_comfyui_resized_avg_rank_64_bf16.safetensors 978227408 \
    374dfbce47a9f44b19a4d78b44c63bf613ba74110077582603b3d74ad3d47254

RUN --mount=type=secret,id=hf_token /fetch_model.sh \
    $HF/$VEDA_T2VA_REPO/minimax_h3_t2va_veda_8nfe_600step_preview_fp8.safetensors \
    veda minimax_h3_t2va_veda_8nfe_600step_preview_fp8.safetensors 275415648 \
    2a8d8845c5342756a2781e8e69563940e4bb573c9a40ebb534915ff8fd76573a

RUN --mount=type=secret,id=hf_token /fetch_model.sh \
    $HF/$VEDA_R2VA_REPO/minimax_h3_r2va_veda_preview_fp8.safetensors \
    veda minimax_h3_r2va_veda_preview_fp8.safetensors 275415752 \
    23edace948693772be33d5cc945d302d2b037a29bd44bd57071bfbdd8b02517d

# --------------------------------------------------------
# Code en dernier : modifier le handler ne retélécharge ni ne repousse les modèles.
# Pas d'extra_model_paths.yaml : il pointe vers /runpod-volume, absent de cette cible.
# --------------------------------------------------------
COPY src/start.sh src/rp_handler.py /
COPY workflows/minimax-h3/ /workflows/
COPY test_input_h3_*.json /
RUN sed -i 's/\r$//' /start.sh && chmod +x /start.sh

WORKDIR /
CMD ["/start.sh"]
